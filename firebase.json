{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "scripts/**",
      ".github/**",
      ".devcontainer/**",
      "data/**",
      "**/*.py",
      "**/*.sh",
      "**/*.md",
      "DEPLOY.md",
      "sa_export.b64",
      "sa_temp.txt"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      }
    ],
    "rewrites": [
      { "source": "/", "destination": "/index.html" }
    ]
  }
}